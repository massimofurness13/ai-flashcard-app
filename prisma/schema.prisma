generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id // matches Supabase auth.users.id (UUID)
  email     String  @unique
  name      String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI image quota — resets monthly to subscription tier's allowance.
  // monthlyImagesUsed tracks count within the current billing window.
  // monthlyImagesResetAt is the next reset time (set on first use each period).
  monthlyImagesUsed    Int       @default(0)
  monthlyImagesResetAt DateTime?
  // Purchased credits beyond the monthly allowance. Never expire.
  imageCredits         Int       @default(0)
  // Free tier lifetime counter (3 images to try AI generation)
  lifetimeFreeImagesUsed Int     @default(0)

  // Engagement / daily goal
  dailyGoal                Int     @default(25)
  goalHitCelebrationShown  Boolean @default(false)

  // Daily-study push reminder. `reminderHour` is 0-23 in the user's local
  // timezone; null means reminders are off. `reminderTimezone` is an IANA
  // identifier (e.g. "Europe/London") captured from the browser when the
  // user enables reminders so the cron job knows when "20:00 local" is.
  // `lastReminderSentAt` prevents double-sending within the same day.
  reminderHour        Int?
  reminderTimezone    String?
  lastReminderSentAt  DateTime?

  folders           Folder[]
  decks             Deck[]
  subscription      Subscription?
  purchases         CreditPurchase[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dhKey  String
  authKey    String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model CreditPurchase {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentIntentId  String   @unique
  bundle                 String   // "100", "300", or "1000"
  creditsAdded           Int
  amountCents            Int
  createdAt              DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?  @unique
  status               String   @default("inactive") // active, canceled, past_due, inactive
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id    String  @id @default(cuid())
  name  String
  emoji String? @default("\ud83d\udcc1")
  color String? @default("#6366f1") // indigo-500

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  decks Deck[]

  @@index([userId])
}

model Deck {
  id          String  @id @default(cuid())
  name        String
  description String?
  emoji       String? @default("\ud83d\udcda")
  frontVoice  String?
  backVoice   String?
  // BCP-47 locale per side (e.g. "es-MX", "en-US"). Typical language deck:
  // front = target language, back = learner's native language. Drives which
  // cloud TTS voice we pick — native-speaker voices per region.
  frontLanguageCode String?
  backLanguageCode  String?

  // Soft-archive. When non-null the deck is hidden from the home list and
  // study config; it still exists for stats history and can be restored.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cards Card[]

  @@index([userId])
  @@index([folderId])
}

model Card {
  id       String  @id @default(cuid())
  front    String
  back     String
  imageUrl String?
  hint     String?
  tags     String? // comma-separated
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  reviews ReviewLog[]

  // SM-2 spaced repetition state
  easeFactor   Float    @default(2.5)
  interval     Int      @default(0)
  repetitions  Int      @default(0)
  nextReviewAt DateTime @default(now())

  @@index([deckId])
  @@index([nextReviewAt])
}

model ReviewLog {
  id         String   @id @default(cuid())
  quality    Int      // 1=Again, 3=Good, 5=Easy
  easeFactor Float
  interval   Int
  reviewedAt DateTime @default(now())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([reviewedAt])
}
