generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id // matches Supabase auth.users.id (UUID)
  email     String  @unique
  name      String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AI image quota — resets monthly to subscription tier's allowance.
  // monthlyImagesUsed tracks count within the current billing window.
  // monthlyImagesResetAt is the next reset time (set on first use each period).
  monthlyImagesUsed    Int       @default(0)
  monthlyImagesResetAt DateTime?
  // Purchased credits beyond the monthly allowance. Never expire.
  imageCredits         Int       @default(0)
  // Free tier lifetime counter (3 images to try AI generation)
  lifetimeFreeImagesUsed Int     @default(0)

  // Engagement / daily goal
  dailyGoal                Int     @default(25)
  goalHitCelebrationShown  Boolean @default(false)

  // Daily-study push reminder. `reminderHour` is 0-23 in the user's local
  // timezone; null means reminders are off. `reminderTimezone` is an IANA
  // identifier (e.g. "Europe/London") captured from the browser when the
  // user enables reminders so the cron job knows when "20:00 local" is.
  // `lastReminderSentAt` prevents double-sending within the same day.
  reminderHour        Int?
  reminderTimezone    String?
  lastReminderSentAt  DateTime?

  // Onboarding answers — captured on first sign-in, used to drop a
  // starter pack into the user's library and to slice analytics
  // ("X% of our users learn Spanish at A1"). Nullable so existing
  // users who pre-date onboarding aren't broken.
  learningLanguage      String?   // ISO 639-1: "es", "fr", "de", ...
  learningLevel         String?   // "A1" | "A2" | "B1" | "B2" | "C1" | "C2" | "unsure"
  onboardingCompletedAt DateTime?

  folders           Folder[]
  decks             Deck[]
  subscription      Subscription?
  purchases         CreditPurchase[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dhKey  String
  authKey    String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model CreditPurchase {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentIntentId  String   @unique
  bundle                 String   // "100", "300", or "1000"
  creditsAdded           Int
  amountCents            Int
  createdAt              DateTime @default(now())
  // Set when Stripe's charge.refunded webhook fires for this
  // purchase. Used as the idempotency key — repeated refund events
  // for the same paymentIntent are ignored once this is set.
  refundedAt             DateTime?

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String?  @unique
  status               String   @default("inactive") // active, canceled, past_due, inactive
  // Billing cadence — drives the credit allowance:
  //   monthly = 500 credits / month, resets at currentPeriodEnd
  //   yearly  = 6,000 credits / year, ALL unlocked upfront on activation,
  //             resets at currentPeriodEnd (a year out)
  plan                 String   @default("monthly")
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  id    String  @id @default(cuid())
  name  String
  emoji String? @default("\ud83d\udcc1")
  color String? @default("#6366f1") // indigo-500

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  decks Deck[]

  @@index([userId])
}

model Deck {
  id          String  @id @default(cuid())
  name        String
  description String?
  emoji       String? @default("\ud83d\udcda")
  frontVoice  String?
  backVoice   String?
  // BCP-47 locale per side (e.g. "es-MX", "en-US"). Typical language deck:
  // front = target language, back = learner's native language. Drives which
  // cloud TTS voice we pick — native-speaker voices per region.
  frontLanguageCode String?
  backLanguageCode  String?

  // Soft-archive. When non-null the deck is hidden from the home list and
  // study config; it still exists for stats history and can be restored.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  cards Card[]

  @@index([userId])
  @@index([folderId])
}

model Card {
  id       String  @id @default(cuid())
  front    String
  back     String
  imageUrl String?
  // Which AI tier produced the current imageUrl ("quick" or "premium").
  // Used by the feedback-for-regen flow so we can regenerate at the
  // same tier the user originally chose.
  imageTier String?
  // One free regen per card, granted in exchange for written feedback.
  // Flips to true once used so feedback after that no longer triggers
  // a paid generation cycle for free.
  freeImageRegenUsed Boolean @default(false)
  hint     String?
  tags     String? // comma-separated
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  reviews        ReviewLog[]
  imageFeedback  ImageFeedback[]

  // SM-2 spaced repetition state
  easeFactor   Float    @default(2.5)
  interval     Int      @default(0)
  repetitions  Int      @default(0)
  nextReviewAt DateTime @default(now())

  @@index([deckId])
  @@index([nextReviewAt])
}

// User-submitted feedback on AI-generated card images. Snapshot the
// front/back/url/tier at submission time so we have ground truth even
// if the user later edits the card or regenerates again — the feedback
// is about a specific render, not the current state.
model ImageFeedback {
  id        String @id @default(cuid())
  userId    String
  cardId    String
  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardFront String
  cardBack  String
  imageUrl  String
  imageTier String   // "quick" or "premium"
  feedback  String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([cardId])
  @@index([createdAt])
}

model ReviewLog {
  id         String   @id @default(cuid())
  quality    Int      // 1=Again, 3=Good, 5=Easy
  easeFactor Float
  interval   Int
  reviewedAt DateTime @default(now())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([reviewedAt])
}

// Pre-built starter packs offered to new users during onboarding.
// One pack per (language, level) combination. The first user to ask
// for a combo we don't have can trigger AI generation, and the
// resulting pack is saved here permanently — every subsequent user
// of that combo gets the cached version cloned into their library.
model StarterPack {
  id          String   @id @default(cuid())
  language    String   // ISO 639-1: "es", "fr", "de", ...
  level       String   // "A1" | ... | "C2"
  name        String
  description String?
  emoji       String?  @default("✨")
  cards       StarterCard[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([language, level])
}

model StarterCard {
  id            String      @id @default(cuid())
  starterPackId String
  starterPack   StarterPack @relation(fields: [starterPackId], references: [id], onDelete: Cascade)
  front         String
  back          String
  hint          String?
  imageUrl      String?
  imageTier     String?
  position      Int         @default(0)

  @@index([starterPackId])
}
