# =============================================================================
# Huella SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the app.

# ----- Supabase Database (Postgres via PgBouncer pooler) -----
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations (session mode, port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# ----- Supabase Project Credentials -----
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ----- Stripe Payments (Pro subscription at $6.99/mo) -----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""

# ----- AI APIs -----
# Anthropic Claude — powers AI flashcard text generation (Pro feature)
ANTHROPIC_API_KEY=""

# Stability AI — powers AI image generation (Pro feature)
STABILITY_API_KEY=""

# ----- Admin / Testing -----
# Comma-separated emails that always get Pro access (bypasses Stripe check)
PRO_ALLOWLIST="massimofurness13@gmail.com"

# ----- Development / Seed -----
# UUID of the user to assign seed data to (optional, for seeding only)
# SEED_USER_ID=""

# ----- Push Notifications (Group 8) -----
# Generate once with: `node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(JSON.stringify(k,null,2))"`
# The public key is exposed to the browser. Keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@huella.app"

# Cron gate — send this header to /api/cron/push-reminders (x-cron-secret)
CRON_SECRET=""

# ----- Product Analytics (PostHog) -----
# Heatmaps, session replay, funnels, event tracking. Free tier covers
# 1M events + 5k replays/mo. Sign up at https://posthog.com (no card),
# create a project, then copy these from Project Settings → API Keys.
# Both vars are public (NEXT_PUBLIC_) — they ship to the browser; the
# Project API Key is write-only by design and safe to expose.
# Leave blank in local dev so you don't burn quota on hot-reloads.
NEXT_PUBLIC_POSTHOG_KEY=""
# Region host: https://us.i.posthog.com (US cloud) or
# https://eu.i.posthog.com (EU cloud). Must match the region you
# picked at signup.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ----- Text-to-Speech (native-speaker voices per language) -----
# Google Cloud TTS — Chirp 3 HD with Neural2 / Wavenet fallback. Native
# speakers recorded per locale (e.g. Mexican Spanish from an actual
# Mexican Spanish speaker). 1M characters/month free tier, then $16/M.
# Setup: Google Cloud Console → enable "Cloud Text-to-Speech API" → create
# service account → download JSON key → paste the whole JSON as a
# single-line string (escape quotes if needed, or use JSON.stringify on
# the file contents).
GOOGLE_SERVICE_ACCOUNT_JSON=""
